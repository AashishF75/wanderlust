<% layout("/layouts/boilerplate") %>

<div class="container my-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-4 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: var(--c-primary);">
                    <i class="fa-solid fa-suitcase-rolling me-1 text-accent"></i> My Trips
                </span>
                <span class="text-muted small">
                    <%= allBookings.length %> <%= allBookings.length === 1 ? 'reservation' : 'reservations' %> recorded
                </span>
            </div>
            <h1 class="fw-bold mb-1" style="color: var(--c-primary); letter-spacing: -0.5px;">My Trips & Reservations</h1>
            <p class="text-muted m-0">Review upcoming check-ins, manage reservations, and look back at past journeys.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/listings" class="btn btn-outline-dark rounded-pill px-4 py-2">
                <i class="fa-solid fa-compass me-2"></i> Explore Stays
            </a>
            <a href="/bookings/host" class="btn btn-dark rounded-pill px-4 py-2">
                <i class="fa-solid fa-house-chimney-user me-2 text-accent"></i> Host Dashboard
            </a>
        </div>
    </div>

    <% if (allBookings.length === 0) { %>
        <!-- Empty State -->
        <div class="py-5 text-center">
            <div class="p-5 bg-white rounded-4 border mx-auto shadow-sm" style="max-width: 580px;">
                <div class="mb-3" style="font-size: 3.5rem; color: var(--c-accent);">
                    <i class="fa-solid fa-plane-departure"></i>
                </div>
                <h3 class="fw-bold mb-2 text-dark" style="letter-spacing: -0.5px;">No trips booked... yet!</h3>
                <p class="text-secondary mb-4" style="line-height: 1.6;">
                    Time to dust off your bags and start planning your next great adventure. Explore handpicked vacation rentals across top destinations worldwide.
                </p>
                <a href="/listings" class="btn btn-dark rounded-pill px-5 py-2 fw-semibold shadow-sm">
                    <i class="fa-solid fa-compass me-2"></i> Start Searching
                </a>
            </div>
        </div>
    <% } else { %>
        <!-- Navigation Tabs -->
        <ul class="nav nav-pills mb-4 gap-2" id="tripsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 py-2 fw-semibold" id="upcoming-tab" data-bs-toggle="pill" data-bs-target="#upcoming" type="button" role="tab">
                    Upcoming (<%= upcoming.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-semibold" id="previous-tab" data-bs-toggle="pill" data-bs-target="#previous" type="button" role="tab">
                    Previous (<%= previous.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-semibold" id="cancelled-tab" data-bs-toggle="pill" data-bs-target="#cancelled" type="button" role="tab">
                    Cancelled (<%= cancelled.length %>)
                </button>
            </li>
        </ul>

        <!-- Tab Contents -->
        <div class="tab-content" id="tripsTabContent">
            <!-- 1. Upcoming Stays Tab -->
            <div class="tab-pane fade show active" id="upcoming" role="tabpanel">
                <% if (upcoming.length === 0) { %>
                    <div class="p-5 bg-white rounded-4 border text-center my-3">
                        <i class="fa-regular fa-calendar-check fs-2 text-muted mb-2"></i>
                        <h5 class="fw-bold text-dark">No upcoming check-ins</h5>
                        <p class="text-muted small m-0">You don't have any confirmed stays booked for the future.</p>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-lg-2 g-4">
                        <% for (let b of upcoming) { %>
                            <div class="col">
                                <div class="card h-100 border rounded-4 shadow-sm overflow-hidden p-3 bg-white">
                                    <div class="row g-3">
                                        <div class="col-sm-5">
                                            <a href="/listings/<%= b.listing._id %>" class="d-block h-100">
                                                <img src="<%= b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80' %>" 
                                                     class="img-fluid rounded-3 w-100 h-100" 
                                                     style="object-fit: cover; min-height: 170px;" 
                                                     alt="<%= b.listing.title %>">
                                            </a>
                                        </div>
                                        <div class="col-sm-7 d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Confirmed
                                                </span>
                                                <span class="text-muted small">#<%= b._id.toString().slice(-8).toUpperCase() %></span>
                                            </div>
                                            <h5 class="fw-bold mb-1 text-dark text-truncate">
                                                <a href="/bookings/<%= b._id %>" class="text-dark text-decoration-none"><%= b.listing.title %></a>
                                            </h5>
                                            <p class="text-muted small mb-2">
                                                <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= b.listing.location %>, <%= b.listing.country %>
                                            </p>

                                            <!-- Dates Box -->
                                            <div class="p-2 bg-light rounded-3 mb-2 small">
                                                <div class="fw-semibold text-dark">
                                                    <i class="fa-regular fa-calendar me-1"></i>
                                                    <%= new Date(b.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> &rarr;
                                                    <%= new Date(b.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                </div>
                                                <div class="text-muted smaller">
                                                    <%= b.nights %> <%= b.nights === 1 ? 'night' : 'nights' %> &bull; <%= b.guests %> <%= b.guests === 1 ? 'guest' : 'guests' %>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="small text-muted">Total Amount:</span>
                                                <span class="fw-bold fs-6" style="color: var(--c-primary);">&#8377; <%= b.totalPrice.toLocaleString("en-IN") %></span>
                                            </div>

                                            <!-- Actions -->
                                            <div class="mt-auto d-flex gap-2">
                                                <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-dark rounded-pill flex-grow-1 py-2 fw-semibold">
                                                    View Details
                                                </a>
                                                <% if (new Date(b.checkIn) > new Date()) { %>
                                                    <form method="POST" action="/bookings/<%= b._id %>/cancel?_method=PATCH" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-2" title="Cancel Reservation">
                                                            Cancel
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- 2. Previous Trips Tab -->
            <div class="tab-pane fade" id="previous" role="tabpanel">
                <% if (previous.length === 0) { %>
                    <div class="p-5 bg-white rounded-4 border text-center my-3">
                        <i class="fa-regular fa-clock-rotate-left fs-2 text-muted mb-2"></i>
                        <h5 class="fw-bold text-dark">No past journeys yet</h5>
                        <p class="text-muted small m-0">Your completed stays will be archived here for easy reference.</p>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-lg-2 g-4">
                        <% for (let b of previous) { %>
                            <div class="col">
                                <div class="card h-100 border rounded-4 shadow-sm p-3 bg-white">
                                    <div class="row g-3">
                                        <div class="col-sm-5">
                                            <img src="<%= b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80' %>" 
                                                 class="img-fluid rounded-3 w-100 h-100" 
                                                 style="object-fit: cover; min-height: 160px;" 
                                                 alt="<%= b.listing.title %>">
                                        </div>
                                        <div class="col-sm-7 d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                                                    Completed Stay
                                                </span>
                                                <span class="text-muted small">#<%= b._id.toString().slice(-8).toUpperCase() %></span>
                                            </div>
                                            <h5 class="fw-bold mb-1 text-dark text-truncate"><%= b.listing.title %></h5>
                                            <p class="text-muted small mb-2"><%= b.listing.location %>, <%= b.listing.country %></p>
                                            <p class="small text-muted mb-2">
                                                Stayed: <%= new Date(b.checkIn).toLocaleDateString() %> &bull; &#8377; <%= b.totalPrice.toLocaleString("en-IN") %>
                                            </p>
                                            <div class="mt-auto d-flex gap-2">
                                                <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-dark rounded-pill flex-grow-1 py-1">Receipt</a>
                                                <a href="/listings/<%= b.listing._id %>" class="btn btn-sm btn-dark rounded-pill flex-grow-1 py-1">Book Again</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- 3. Cancelled Trips Tab -->
            <div class="tab-pane fade" id="cancelled" role="tabpanel">
                <% if (cancelled.length === 0) { %>
                    <div class="p-5 bg-white rounded-4 border text-center my-3">
                        <i class="fa-solid fa-shield-heart fs-2 text-muted mb-2"></i>
                        <h5 class="fw-bold text-dark">No cancelled reservations</h5>
                        <p class="text-muted small m-0">You don't have any cancelled trips on record.</p>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-lg-2 g-4">
                        <% for (let b of cancelled) { %>
                            <div class="col">
                                <div class="card h-100 border rounded-4 shadow-sm p-3 bg-white opacity-75">
                                    <div class="row g-3">
                                        <div class="col-sm-5">
                                            <img src="<%= b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80' %>" 
                                                 class="img-fluid rounded-3 w-100 h-100" 
                                                 style="object-fit: cover; min-height: 160px; filter: grayscale(40%);" 
                                                 alt="<%= b.listing.title %>">
                                        </div>
                                        <div class="col-sm-7 d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1 small">
                                                    <i class="fa-solid fa-xmark me-1"></i> Cancelled
                                                </span>
                                                <span class="text-muted small">#<%= b._id.toString().slice(-8).toUpperCase() %></span>
                                            </div>
                                            <h5 class="fw-bold mb-1 text-dark text-truncate"><%= b.listing.title %></h5>
                                            <p class="text-muted small mb-2"><%= b.listing.location %>, <%= b.listing.country %></p>
                                            <p class="small text-muted mb-3">
                                                Was scheduled for: <%= new Date(b.checkIn).toLocaleDateString() %> &bull; &#8377; <%= b.totalPrice.toLocaleString("en-IN") %>
                                            </p>
                                            <div class="mt-auto">
                                                <a href="/listings/<%= b.listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill w-100">
                                                    Re-book Stay
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

