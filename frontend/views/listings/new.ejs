<% layout("/layouts/boilerplate") %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card p-4 p-md-5 rounded-4 border shadow-sm bg-white">
                <div class="mb-4">
                    <span class="badge rounded-pill mb-2" style="background-color: var(--c-accent); color: #fff;">Host Mode</span>
                    <h2 class="fw-bold mb-1" style="color: var(--c-primary);">Create a New Listing</h2>
                    <p class="text-muted small">Share your property with travelers worldwide. Provide accurate details to maximize bookings.</p>
                </div>

                <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold small text-muted">Property Title</label>
                        <input type="text" name="listing[title]" id="title" class="form-control" placeholder="e.g. Seaside Sunset Luxury Villa" required>
                        <div class="invalid-feedback">Please enter an engaging property title.</div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold small text-muted">Description</label>
                        <textarea id="description" name="listing[description]" class="form-control" rows="4" placeholder="Describe the ambiance, views, and unique amenities of your home..." required></textarea>
                        <div class="invalid-feedback">Please enter a description for your stay.</div>
                    </div>

                    <!-- Category & Price -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="category" class="form-label fw-semibold small text-muted">Property Category</label>
                            <select name="listing[category]" id="category" class="form-select">
                                <option value="Trending" selected>Trending</option>
                                <option value="Room">Room</option>
                                <option value="City">City</option>
                                <option value="Mountain">Mountain</option>
                                <option value="Cottage">Cottage</option>
                                <option value="Pool">Pool</option>
                                <option value="Farms">Farms</option>
                                <option value="Camping">Camping</option>
                                <option value="Arctic">Arctic</option>
                                <option value="Doms">Doms</option>
                                <option value="Sailboats">Sailboats</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="price" class="form-label fw-semibold small text-muted">Price per Night (INR)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">&#8377;</span>
                                <input type="number" id="price" name="listing[price]" class="form-control" placeholder="e.g. 7500" min="0" required>
                                <div class="invalid-feedback">Please enter a valid price per night.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Location & Country -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="location" class="form-label fw-semibold small text-muted">City / Locality</label>
                            <input type="text" id="location" name="listing[location]" class="form-control" placeholder="e.g. Candolim, Goa" required>
                            <div class="invalid-feedback">Please enter the location.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="country" class="form-label fw-semibold small text-muted">Country</label>
                            <input type="text" id="country" name="listing[country]" class="form-control" placeholder="e.g. India" required>
                            <div class="invalid-feedback">Please enter the country.</div>
                        </div>
                    </div>

                    <!-- Cloudinary Photo Upload -->
                    <div class="mb-4">
                        <label for="image" class="form-label fw-semibold small text-muted">Property Photo (Cloudinary Upload)</label>
                        <input type="file" id="image" name="listing[image]" class="form-control" accept="image/png, image/jpeg, image/jpg" required>
                        <div class="form-text small text-muted">Supported formats: JPEG, JPG, PNG. Files are automatically optimized and served via Cloudinary CDN.</div>
                        <div class="invalid-feedback">Please choose a property image file.</div>
                    </div>

                    <div class="d-flex gap-3 align-items-center">
                        <button type="submit" class="btn btn-auth-primary px-4 py-2 w-auto">
                            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Publish Listing
                        </button>
                        <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
