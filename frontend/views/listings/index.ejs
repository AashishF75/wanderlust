<!-- ==============================================================================
     CLIENT INTERACTIVITY SCRIPTS: TAX TOGGLE
     ============================================================================== -->
<script>
    // Tax Calculation Toggle
    const taxToggle = document.getElementById('taxSwitchToggle');
    if (taxToggle) {
        taxToggle.addEventListener('change', () => {
            const taxElements = document.querySelectorAll('.tax-info');
            taxElements.forEach(el => {
                el.style.display = taxToggle.checked ? 'inline' : 'none';
            });
        });
    }
</script>
