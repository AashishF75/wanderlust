<% if(success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2 my-3 mx-auto" style="max-width: 680px; background-color: #e8f5e9; color: #1b5e20;" role="alert">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div class="flex-grow-1 fw-medium">
            <%= success %>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2 my-3 mx-auto" style="max-width: 680px; background-color: #ffebee; color: #c62828;" role="alert">
        <i class="fa-solid fa-circle-exclamation fs-5"></i>
        <div class="flex-grow-1 fw-medium">
            <%= error %>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
